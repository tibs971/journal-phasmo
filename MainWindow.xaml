<Window x:Class="PhasmoCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Journal Phasmo"
        Width="1100" Height="760" MinWidth="320" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#0E1116" Topmost="True" Opacity="0.97"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- barre de titre maison : déplacer la fenêtre, boutons -->
    <Border Grid.Row="0" Background="#171B23" MouseLeftButtonDown="Bar_Drag">
      <DockPanel LastChildFill="False" Margin="8,4">
        <TextBlock DockPanel.Dock="Left" Text="JOURNAL PHASMO" Foreground="#A68CFF"
                   FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Left" x:Name="Hint" Margin="10,0,0,0"
                   x:FieldModifier="private" Text="raccourcis en cours de chargement — modifiables dans ⚙"
                   Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>

        <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" Style="{StaticResource BarBtn}"
                ToolTip="Fermer"/>
        <Button DockPanel.Dock="Right" x:Name="BtnMax" Content="▢" Click="Max_Click" Style="{StaticResource BarBtn}"
                ToolTip="Agrandir / restaurer (double-clic sur la barre)"/>
        <Button DockPanel.Dock="Right" Content="—" Click="Min_Click" Style="{StaticResource BarBtn}"
                ToolTip="Réduire"/>
        <Button DockPanel.Dock="Right" x:Name="BtnTop" Content="📌" Click="Top_Click" Style="{StaticResource BarBtn}"
                ToolTip="Toujours au-dessus (F7)"/>
        <Button DockPanel.Dock="Right" Content="⚙" Click="Settings_Click" Style="{StaticResource BarBtn}"
                ToolTip="Réglages : raccourcis et transparence"/>
        <Button DockPanel.Dock="Right" x:Name="BtnTimers" Content="⏱" Click="Timers_Click" Style="{StaticResource BarBtn}"
                ToolTip="Fenêtre flottante des minuteurs (F6)"/>
        <ComboBox DockPanel.Dock="Right" x:Name="CbOpacity" Width="70" Margin="0,0,6,0"
                  SelectionChanged="Opacity_Changed" ToolTip="Opacité">
          <ComboBoxItem Content="100 %" Tag="1.0"/>
          <ComboBoxItem Content="97 %"  Tag="0.97" IsSelected="True"/>
          <ComboBoxItem Content="85 %"  Tag="0.85"/>
          <ComboBoxItem Content="70 %"  Tag="0.7"/>
        </ComboBox>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Web"/>

      <!-- panneau de réglages, dans la fenêtre : pas de seconde fenêtre à faire planter -->
      <Border x:Name="Settings" Visibility="Collapsed" Background="#F20E1116"
              BorderBrush="#2A303C" BorderThickness="0,1,0,0">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="RACCOURCIS" Foreground="#A68CFF" FontSize="11" FontFamily="Segoe UI"/>
            <TextBlock Foreground="#6E7689" FontSize="11.5" FontFamily="Segoe UI" TextWrapping="Wrap"
                       Text="Cliquez un bouton, puis appuyez sur la touche voulue (Ctrl, Alt ou Maj possibles). Échap annule. Pavé numérique et boutons de souris acceptés (molette, boutons 4 et 5 ; les clics gauche et droit restent au jeu). Les raccourcis sont désactivés tant que ce panneau est ouvert. Encens, chasse, recharge et tap suivent aussi le panneau « Raccourcis clavier » du journal : changez-les là-bas et ils s'appliquent ici."/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="KeyList"/>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="TRANSPARENCE DE LA FENÊTRE DES MINUTEURS" Foreground="#A68CFF"
                       FontSize="11" FontFamily="Segoe UI" Margin="0,0,0,6"/>
            <DockPanel Margin="0,2">
              <TextBlock DockPanel.Dock="Left" Width="190" Foreground="#8C94A6" FontFamily="Segoe UI"
                         VerticalAlignment="Center" Text="Décor (cadre et fonds)"/>
              <TextBlock DockPanel.Dock="Right" x:Name="LblBg" Width="46" TextAlignment="Right" Foreground="#8C94A6"/>
              <Slider x:Name="SlBg" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                      ValueChanged="Bg_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock DockPanel.Dock="Left" Width="190" Foreground="#8C94A6" FontFamily="Segoe UI"
                         VerticalAlignment="Center" Text="Fenêtre entière (texte compris)"/>
              <TextBlock DockPanel.Dock="Right" x:Name="LblWin" Width="46" TextAlignment="Right" Foreground="#8C94A6"/>
              <Slider x:Name="SlWin" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                      ValueChanged="Win_Changed"/>
            </DockPanel>
            <TextBlock Foreground="#6E7689" FontSize="11" FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="À 0 % de décor, les chiffres restent nets et une poignée discrète en haut à gauche permet encore de déplacer la fenêtre."/>
          </StackPanel>

          <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Raccourcis par défaut" Click="Defaults_Click" Padding="12,6"/>
            <Button DockPanel.Dock="Right" Content="Fermer les réglages" Click="CloseSettings_Click" Padding="18,6"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
