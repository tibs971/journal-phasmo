<Window x:Class="PhasmoCompanion.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renommer les minuteurs"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Drag">

  <Border Background="#0E1116" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="10" Padding="20,16">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
    </Border.Effect>

    <StackPanel>
      <DockPanel LastChildFill="False" Margin="0,0,0,10">
        <TextBlock DockPanel.Dock="Left" Text="MINUTEURS"
                   Foreground="#A68CFF" FontFamily="Segoe UI" FontSize="11"/>
        <Button DockPanel.Dock="Right" Content="✕" Click="Cancel_Click" Style="{StaticResource BarBtn}"/>
      </DockPanel>

      <TextBlock Text="Renommer" Foreground="#E3E6EC"
                 FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Margin="0,4,0,14" TextWrapping="Wrap"
                 Text="Le nom s'affiche au-dessus du chrono, suivi de sa touche. Laissez vide pour revenir au nom d'origine."
                 Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="12"/>

      <TextBlock Text="1er minuteur (encens)" Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="11" Margin="0,0,0,3"/>
      <TextBox x:Name="N1" Height="30" MaxLength="18" Margin="0,0,0,10"
               Background="#171B23" BorderBrush="#2A303C" BorderThickness="1" Foreground="#E3E6EC"
               FontFamily="Segoe UI" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"
               KeyDown="Champ_KeyDown"/>

      <TextBlock Text="2e minuteur (chasse)" Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="11" Margin="0,0,0,3"/>
      <TextBox x:Name="N2" Height="30" MaxLength="18" Margin="0,0,0,10"
               Background="#171B23" BorderBrush="#2A303C" BorderThickness="1" Foreground="#E3E6EC"
               FontFamily="Segoe UI" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"
               KeyDown="Champ_KeyDown"/>

      <TextBlock Text="3e minuteur (chrono en secondes)" Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="11" Margin="0,0,0,3"/>
      <TextBox x:Name="N4" Height="30" MaxLength="18" Margin="0,0,0,10"
               Background="#171B23" BorderBrush="#2A303C" BorderThickness="1" Foreground="#E3E6EC"
               FontFamily="Segoe UI" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"
               KeyDown="Champ_KeyDown"/>

      <TextBlock Text="4e minuteur (recharge)" Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="11" Margin="0,0,0,3"/>
      <TextBox x:Name="N3" Height="30" MaxLength="18" Margin="0,0,0,16"
               Background="#171B23" BorderBrush="#2A303C" BorderThickness="1" Foreground="#E3E6EC"
               FontFamily="Segoe UI" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"
               KeyDown="Champ_KeyDown"/>

      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Left" Content="Noms d'origine" Click="Defaut_Click" Padding="12,6"/>
        <Button DockPanel.Dock="Right" Content="Valider" Click="Ok_Click" Padding="20,6" IsDefault="True"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
