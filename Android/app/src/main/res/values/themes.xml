        <item name="colorOnSecondary">@color/ard_sur_retenu</item>
        <item name="colorError">@color/ard_alarme</item>
        <item name="android:colorBackground">@color/ard_fond</item>
        <item name="colorSurface">@color/ard_surface</item>
        <item name="colorSurfaceVariant">@color/ard_haute</item>
        <item name="colorOnSurface">@color/ard_encre</item>
        <item name="colorOnSurfaceVariant">@color/ard_pale</item>
        <item name="colorOutline">@color/ard_contour</item>
        <item name="colorOutlineVariant">@color/ard_filet</item>
        <item name="android:windowBackground">@color/ard_fond</item>
        <item name="android:isLightTheme">false</item>
    </style>

