<?xml version="1.0" encoding="utf-8"?>
<!-- Le bandeau du haut ne défile pas : pendant qu'on parcourt les 98 observations,
     le nombre d'entités restantes et leurs noms restent sous les yeux. C'est le
     geste réel du jeu — on jette un oeil, on ne lit pas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/barre_recherche" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorPrimary"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtRestantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texte.Grand"
                android:textColor="?attr/colorOnSurface" />

            <!-- Tant qu'il reste beaucoup d'entités on les parcourt ; quand il n'en reste
                 que quelques-unes on les désigne. Les deux gestes n'ont pas la même
                 forme, donc l'affichage change de forme avec eux. -->
            <HorizontalScrollView
                android:id="@+id/defilRestantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="6dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsRestantes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/lignesRestantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Écartées à la main : on se trompe, et il faut pouvoir revenir dessus
         longtemps après, pas seulement pendant les six secondes du message. -->
    <LinearLayout
        android:id="@+id/zoneReprise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView android:id="@+id/titrePreuves" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Preuves"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" android:paddingTop="12dp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsPreuves"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/legende_etats"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nombre de preuves de la difficulté"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" android:paddingTop="18dp"
                android:paddingBottom="6dp" />
            <include layout="@layout/bloc_nb_preuves" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Vitesse de base"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" android:paddingTop="18dp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsVitesses"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/legende_vitesses"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCache"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Resté caché, jamais détecté" />
            <TextView android:id="@+id/noteCache"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="4dp" android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ce que vous avez observé"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" android:paddingTop="18dp" />
            <LinearLayout android:id="@+id/zoneObs"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pied_de_page"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="26dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
