<Window x:Class="PhasmoCompanion.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minuteurs"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Left="40" Top="40" Opacity="1.0"
        MouseLeftButtonDown="Drag">

  <Window.Resources>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8C94A6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E3E6EC"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Msg" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Width" Value="126"/>
      <Setter Property="Height" Value="30"/>
    </Style>
  </Window.Resources>

  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem x:Name="MiResetAll" Header="Tout remettre à zéro (F4)" Click="ResetAll_Click"/>
      <MenuItem x:Name="MiAutoCd" Header="Lancer la recharge à la fin de la chasse" IsCheckable="True" IsChecked="True"/>
      <MenuItem x:Name="MiTop" Header="Toujours au-dessus du jeu" IsCheckable="True" IsChecked="False"
                Click="Top_Click" ToolTip="À cocher seulement si le jeu est en fenêtré sans bordure (sinon le plein écran saute)"/>
      <MenuItem x:Name="MiLock" Header="Verrouiller la position" IsCheckable="True"/>
      <Separator/>
      <MenuItem Header="Taille de la fenêtre">
        <MenuItem Header="60 %"  Tag="0.6"  Click="Echelle_Click"/>
        <MenuItem Header="75 %"  Tag="0.75" Click="Echelle_Click"/>
        <MenuItem Header="85 %"  Tag="0.85" Click="Echelle_Click"/>
        <MenuItem Header="100 %" Tag="1.0"  Click="Echelle_Click"/>
        <MenuItem Header="125 %" Tag="1.25" Click="Echelle_Click"/>
      </MenuItem>
      <MenuItem Header="Minuteurs affichés">
        <MenuItem x:Name="MiVoir1" Header="1er minuteur" IsCheckable="True" IsChecked="True" Click="Voir_Click"/>
        <MenuItem x:Name="MiVoir2" Header="2e minuteur"  IsCheckable="True" IsChecked="True" Click="Voir_Click"/>
        <MenuItem x:Name="MiVoir4" Header="Chrono"       IsCheckable="True" IsChecked="True" Click="Voir_Click"/>
        <MenuItem x:Name="MiVoir3" Header="3e minuteur"  IsCheckable="True" IsChecked="True" Click="Voir_Click"/>
      </MenuItem>
      <MenuItem Header="Renommer les minuteurs…" Click="Renommer_Click"/>
      <MenuItem Header="Opacité du décor (texte intact)">
        <MenuItem Header="100 %" Tag="1.0"  Click="BgOpacity_Click"/>
        <MenuItem Header="85 %"  Tag="0.85" Click="BgOpacity_Click"/>
        <MenuItem Header="60 %"  Tag="0.6"  Click="BgOpacity_Click"/>
        <MenuItem Header="30 %"  Tag="0.3"  Click="BgOpacity_Click"/>
        <MenuItem Header="0 % (décor invisible)" Tag="0.0" Click="BgOpacity_Click"/>
      </MenuItem>
      <MenuItem Header="Opacité de la fenêtre entière">
        <MenuItem Header="100 %" Tag="1.0"  Click="Opacity_Click"/>
        <MenuItem Header="90 %"  Tag="0.9"  Click="Opacity_Click"/>
        <MenuItem Header="75 %"  Tag="0.75" Click="Opacity_Click"/>
        <MenuItem Header="55 %"  Tag="0.55" Click="Opacity_Click"/>
      </MenuItem>
      <Separator/>
      <MenuItem x:Name="MiHide" Header="Masquer (F6)" Click="Hide_Click"/>
    </ContextMenu>
  </Window.ContextMenu>

  <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Padding="9,7">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
    </Border.LayoutTransform>
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
    </Border.Effect>
    <Border.Background>
      <SolidColorBrush x:Name="RootBrush" Color="#161A22" Opacity="0.85"/>
    </Border.Background>
    <Border.BorderBrush>
      <SolidColorBrush x:Name="RootBorderBrush" Color="#2A303C" Opacity="0.85"/>
    </Border.BorderBrush>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
        <Border x:Name="Grip" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" Cursor="SizeAll"
                ToolTip="Glisser pour déplacer la fenêtre">
          <TextBlock Text="⠿" FontSize="12" Foreground="#C9D1DC" FontFamily="Segoe UI"/>
        </Border>
        <!-- Le clic droit ouvre déjà ce menu, mais rien ne le disait assez :
             cet engrenage ouvre exactement le même, au clic gauche. -->
        <Button x:Name="BtnOptions" Click="Options_Click" Cursor="Hand" Margin="0,0,6,0"
                Padding="5,1" BorderThickness="0" Foreground="#C9D1DC"
                FontFamily="Segoe UI" FontSize="12" Content="⚙"
                ToolTip="Options des minuteurs : taille, opacité, minuteurs affichés, renommer, masquer">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#3A4150"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock x:Name="HintLine" Text="⚙ ou clic droit : options · glisser pour déplacer"
                   Foreground="#8C94A6" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border x:Name="BoxSmudge" CornerRadius="6" BorderThickness="1" Padding="8,5" Margin="0,0,6,0">
          <StackPanel Width="130">
            <TextBlock Style="{StaticResource Lbl}" x:Name="LblSmudge" Text="Encens"/>
            <TextBlock x:Name="TSmudge" Style="{StaticResource Big}" Text="0:00"/>
            <TextBlock x:Name="MSmudge" Style="{StaticResource Msg}"/>
          </StackPanel>
        </Border>
        <Border x:Name="BoxHunt" CornerRadius="6" BorderThickness="1" Padding="8,5" Margin="0,0,6,0">
          <StackPanel Width="130">
            <TextBlock Style="{StaticResource Lbl}" x:Name="LblHunt" Text="Chasse"/>
            <TextBlock x:Name="THunt" Style="{StaticResource Big}" Text="0:00"/>
            <TextBlock x:Name="MHunt" Style="{StaticResource Msg}"/>
          </StackPanel>
        </Border>
        <Border x:Name="BoxSec" CornerRadius="6" BorderThickness="1" Padding="8,5" Margin="0,0,6,0">
          <StackPanel Width="130">
            <TextBlock Style="{StaticResource Lbl}" x:Name="LblSec" Text="Chrono"/>
            <TextBlock x:Name="TSec" Style="{StaticResource Big}" Text="0,0 s"/>
            <TextBlock x:Name="MSec" Style="{StaticResource Msg}"/>
          </StackPanel>
        </Border>
        <Border x:Name="BoxCd" CornerRadius="6" BorderThickness="1" Padding="8,5">
          <StackPanel Width="130">
            <TextBlock Style="{StaticResource Lbl}" x:Name="LblCd" Text="Recharge"/>
            <TextBlock x:Name="TCd" Style="{StaticResource Big}" Text="0:00"/>
            <TextBlock x:Name="MCd" Style="{StaticResource Msg}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
