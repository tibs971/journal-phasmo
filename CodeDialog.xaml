<Window x:Class="PhasmoCompanion.CodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification"
        Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Drag">

  <Border Background="#0E1116" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="10" Padding="20,16">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
    </Border.Effect>

    <StackPanel>
      <DockPanel LastChildFill="False" Margin="0,0,0,10">
        <TextBlock x:Name="Etape" DockPanel.Dock="Left" Text="ÉTAPE 1 / 2"
                   Foreground="#A68CFF" FontFamily="Segoe UI" FontSize="11"/>
        <Button DockPanel.Dock="Right" Content="✕" Click="Cancel_Click" Style="{StaticResource BarBtn}"/>
      </DockPanel>

      <TextBlock x:Name="Titre" Text="Accès réservé" Foreground="#E3E6EC"
                 FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="SousTitre" Margin="0,4,0,14" TextWrapping="Wrap"
                 Text="Saisissez le code pour continuer."
                 Foreground="#8C94A6" FontFamily="Segoe UI" FontSize="12"/>

      <Border Background="#171B23" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="6" Padding="2">
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="BtnOeil" Content="👁" Width="34" Height="30"
                  Click="Oeil_Click" Style="{StaticResource BarBtn}"
                  ToolTip="Afficher ou masquer le code"/>
          <Grid>
            <PasswordBox x:Name="Masque" Height="30" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Foreground="#E3E6EC"
                         FontFamily="Consolas" FontSize="15" Padding="8,0"
                         PasswordChar="●" MaxLength="64"
                         PasswordChanged="Masque_Changed" KeyDown="Champ_KeyDown"/>
            <TextBox x:Name="Clair" Height="30" VerticalContentAlignment="Center" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0" Foreground="#E3E6EC"
                     FontFamily="Consolas" FontSize="15" Padding="8,0" MaxLength="64"
                     TextChanged="Clair_Changed" KeyDown="Champ_KeyDown"/>
          </Grid>
        </DockPanel>
      </Border>

      <TextBlock x:Name="Erreur" Margin="2,8,0,0" Foreground="#F0736B" FontFamily="Segoe UI"
                 FontSize="12" Visibility="Collapsed" Text="Code incorrect."/>

      <DockPanel Margin="0,16,0,0" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" x:Name="Essais" VerticalAlignment="Center"
                   Foreground="#6E7689" FontFamily="Segoe UI" FontSize="11"/>
        <Button DockPanel.Dock="Right" Content="Valider" Click="Ok_Click" Padding="20,6" IsDefault="True"/>
        <!-- IsCancel suffit : ajouter un Click ferait fixer DialogResult deux fois -->
        <Button DockPanel.Dock="Right" Content="Annuler" Padding="14,6"
                Margin="0,0,8,0" IsCancel="True"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
